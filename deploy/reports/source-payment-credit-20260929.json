"Tedad":0.000,"Diameter":0.000,"ArzId":0,"FactorSite":"0","DateSave1":null,"DateSave2":null,"RowFactor":null,"RowFactor_Id":null},{"Sodor":77227,"Printed":false,"Checked":0,"Tag1":0,"Tag2":0,"Unit":0,"Text":"","BedArz":0.000000000000000,"BesArz":0.000000000000000,"Nerkh":0.000000000000000,"Dep":0,"Id1":0,"Id2":0,"Id3":0,"Id4":0,"NSOODK":0.000,"OtherUnitId1":0,"OtherUnitId2":0,"Length":0.000,"Width":0.000,"Tedad":0.000,"Diameter":0.000,"ArzId":0,"FactorSite":"0","DateSave1":null,"DateSave2":null,"RowFactor":null,"RowFactor_Id":null},{"Sodor":76986,"Printed":false,"Checked":0,"Tag1":0,"Tag2":0,"Unit":0,"Text":"","BedArz":0.000000000000000,"BesArz":0.000000000000000,"Nerkh":0.000000000000000,"Dep":0,"Id1":0,"Id2":0,"Id3":0,"Id4":0,"NSOODK":0.000,"OtherUnitId1":0,"OtherUnitId2":0,"Length":0.000,"Width":0.000,"Tedad":0.000,"Diameter":0.000,"ArzId":0,"FactorSite":"0","DateSave1":null,"DateSave2":null,"RowFactor":null,"RowFactor_Id":null},{"Sodor":76977,"Printed":false,"Checked":0,"Tag1":0,"Tag2":0,"Unit":0,"Text":"","BedArz":0.000000000000000,"BesArz":0.000000000000000,"Nerkh":0.000000000000000,"Dep":0,"Id1":0,"Id2":0,"Id3":0,"Id4":0,"NSOODK":0.000,"OtherUnitId1":0,"OtherUnitId2":0,"Length":0.000,"Width":0.000,"Tedad":0.000,"Diameter":0.000,"ArzId":0,"FactorSite":"0","DateSave1":null,"DateSave2":null,"RowFactor":null,"RowFactor_Id":null},{"Sodor":76800,"Printed":false,"Checked":0,"Tag1":0,"Tag2":0,"Unit":0,"Text":"","BedArz":0.000000000000000,"BesArz":0.000000000000000,"Nerkh":0.000000000000000,"Dep":0,"Id1":0,"Id2":0,"Id3":0,"Id4":0,"NSOODK":0.000,"OtherUnitId1":0,"OtherUnitId2":0,"Length":0.000,"Width":0.000,"Tedad":0.000,"Diameter":0.000,"ArzId":0,"FactorSite":"0","DateSave1":null,"DateSave2":null,"RowFactor":null,"RowFactor_Id":null},{"Sodor":76771,"Printed":false,"Checked":0,"Tag1":0,"Tag2":0,"Unit":0,"Text":"","BedArz":0.000000000000000,"BesArz":0.000000000000000,"Nerkh":0.000000000000000,"Dep":0,"Id1":0,"Id2":0,"Id3":0,"Id4":0,"NSOODK":0.000,"OtherUnitId1":0,"OtherUnitId2":0,"Length":0.000,"Width":0.000,"Tedad":0.000,"Diameter":0.000,"ArzId":0,"FactorSite":"0","DateSave1":null,"DateSave2":null,"RowFactor":null,"RowFactor_Id":null}],[{"name":"vmInvoice","type_desc":"VIEW","definition":"\r\n\r\n\r\nCREATE VIEW [digimall].[vmInvoice]\r\nAS\r\nSELECT  fo.ShFactor invoice_id ,\r\n        fo.ShFactor database_id ,\r\n        \u0027\u0027 digimal_invoice_id ,\r\n        ISNULL(pm.Tell,\u0027\u0027) AS phone,\r\n\t\tp.Name first_name,\r\n\t\tp.Famil last_name,\r\n\t\tISNULL(kala.CreateTime,\u0027\u0027) invoice_created,\r\n\t\tISNULL(kala.ModifyTime,\u0027\u0027) invoice_updated,\r\n\t\t0 cash_desk_id,\r\n\t\tfo.UserIDAdd cashier_id,\r\n\t\t\u0027\u0027 cashier_phone,\r\n\t\tfo.Sharh des,\r\n\t\tISNULL(kala.Mab,0) amount,\r\n\t\tISNULL(kala.Takh,0) cash_desk_items_discount,\r\n\t\tISNULL(amel.MabTakh,0) + ISNULL(kala.Takh,0) cash_desk_discount,\r\n\t\t0 digimall_discount,\r\n\t\tISNULL(kol.MabKol,0) payable_amount,\r\n\t\tCASE WHEN ISNULL(tas.MabTasviye,0) = kol.MabKol THEN 1 ELSE 0 END payment_state,\r\n\t\tISNULL(tas.Time,0) payment_time,\r\n\t\t0 payment_type,\r\n\t\tISNULL(tas.MabTasviye,0) payment_amount,\r\n\t\t\u0027\u0027 AS payment_ref_number\r\n\r\n\t\t\r\nFROM    dbo.TblFactorOnvan AS fo\r\n        LEFT JOIN dbo.TblPerson AS p ON p.Sh_ozviat = fo.CustumCod\r\n        LEFT JOIN dbo.Func_PersonTell (2) AS pm ON pm.ShOzviat = p.Sh_ozviat\r\n        LEFT JOIN dbo.TblUser AS u ON u.Id = fo.UserIDAdd\r\n        LEFT JOIN digimall.Func_digimall_SumMabKala() AS kala ON kala.Factor = fo.ShFactor\r\n        LEFT JOIN digimall.Func_digimall_SumMabAmel() AS amel ON amel.Factor = fo.ShFactor\r\n        LEFT JOIN digimall.Func_digimall_SumMabTasviye() AS tas ON tas.Factor = fo.ShFactor\r\n\t\tLEFT JOIN digimall.Func_digimall_SumMabKol() AS kol ON kol.Factor = fo.ShFactor\r\nWHERE   fo.Type = 203;\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n"},{"name":"vwInvoiceDetails","type_desc":"VIEW","definition":"\r\n\r\n\r\nCREATE VIEW [digimall].[vwInvoiceDetails]\r\nAS\r\nSELECT  t.Sodor record_id ,\r\n        t.Factor invoice_id ,\r\n        t.Factor database_id,\r\n\t\tt.Idkala product_id,\r\n\t\tk.Name name,\r\n\t\tt.TED quantity,\r\n\t\tCAST(ROUND((t.Bes+t.Takh)/t.TED,0) AS BIGINT) unit_amount,\r\n\t\tCAST(t.Bes + t.Takh AS BIGINT) amount,\r\n\t\tCAST(ROUND((t.Takh)/t.TED,0) AS BIGINT) unit_cash_desk_discount,\r\n\t\tCAST(ROUND(t.Bes/t.TED,0) AS BIGINT) unit_payable_amount,\r\n\t\tCAST(t.Takh AS BIGINT) cash_desk_discount,\r\n\t\tCAST(t.Bes AS BIGINT) payable_amount\r\nFROM    dbo.TR AS t \r\nLEFT JOIN dbo.TblKala AS k ON k.IDAnbar = t.IdAnbr AND k.IDKala = t.Idkala\r\nWHERE   Type = 203\r\n        AND IdAnbr \u003e 0;\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n"}],[{"s":"digimall","t":"vmInvoice"},{"s":"digimall","t":"vwInvoiceDetails"}]],"database":"Sepand_One_1405","machine":"DESKTOP-GCTP2FH"}
