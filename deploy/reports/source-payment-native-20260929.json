{"sets":[[{"s":"digimall","name":"Func_digimall_SumMabAmel","definition":"\r\nCREATE FUNCTION [digimall].[Func_digimall_SumMabAmel]\r\n(\t \r\n\t \r\n) \r\nRETURNS TABLE  \r\nAS \r\nRETURN  \r\n( \r\n\tSELECT Factor,SUM(Bed-Bes) AS MabTakh  FROM dbo.TR\r\n\tWHERE Type = 203 AND Tp1\u003e0 AND IdAnbr = 0\r\n\tGROUP BY Factor\r\n)\r\n\r\n"},{"s":"digimall","name":"Func_digimall_SumMabKala","definition":"\r\nCREATE FUNCTION [digimall].[Func_digimall_SumMabKala]\r\n(\t \r\n\t \r\n) \r\nRETURNS TABLE  \r\nAS \r\nRETURN  \r\n( \r\n\tSELECT Factor,SUM(Bes+Takh) AS Mab,SUM(Takh) AS Takh,dbo.Shamsi_To_Miladi(MIN(Time)) AS CreateTime,dbo.Shamsi_To_Miladi(MAX(Time)) AS ModifyTime  FROM dbo.TR\r\n\tWHERE Type = 203 AND IdAnbr\u003e0\r\n\tGROUP BY Factor\r\n)\r\n\r\n"},{"s":"digimall","name":"Func_digimall_SumMabKol","definition":"\r\nCREATE FUNCTION [digimall].[Func_digimall_SumMabKol]\r\n(\t \r\n\t \r\n) \r\nRETURNS TABLE  \r\nAS \r\nRETURN  \r\n( \r\n\tSELECT Factor,SUM(Bes-Bed) AS MabKol  FROM dbo.TR\r\n\tWHERE Type = 203 AND (Tp1\u003e0 OR IdAnbr\u003e0)\r\n\tGROUP BY Factor\r\n)\r\n\r\n"},{"s":"digimall","name":"Func_digimall_SumMabTasviye","definition":"\r\nCREATE FUNCTION [digimall].[Func_digimall_SumMabTasviye]\r\n(\t \r\n\t \r\n) \r\nRETURNS TABLE  \r\nAS \r\nRETURN  \r\n( \r\n\tSELECT Factor,SUM(Bed) AS MabTasviye,dbo.Shamsi_To_Miladi(MAX(Time)) AS Time  FROM dbo.TR\r\n\tWHERE Type = 203 AND Tp1=0 AND IdAnbr = 0\r\n\tGROUP BY Factor\r\n)\r\n\r\n"}],[{"FactorCust":"22814","invoice_id":22304,"payable_amount":7990000,"payment_amount":7990000,"payment_state":1},{"FactorCust":"22858","invoice_id":22348,"payable_amount":7870000,"payment_amount":7870000,"payment_state":1},{"FactorCust":"22992","invoice_id":22481,"payable_amount":6270000,"payment_amount":6270000,"payment_state":1},{"FactorCust":"23024","invoice_id":22513,"payable_amount":1490000,"payment_amount":1490000,"payment_state":1},{"FactorCust":"23031","invoice_id":22520,"payable_amount":4100000,"payment_amount":41000